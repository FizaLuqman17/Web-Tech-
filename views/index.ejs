<!-- Express EJS Landing Page -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Havenly - The #1 Interior Design Service">
    <meta name="author" content="Havenly">
    <title>Havenly - Interior Design</title>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body>

    <!-- ===================== NAVBAR ===================== -->
    <header id="navbar">
        <!-- Hamburger Menu Button -->
        <button id="hamburger-btn" aria-label="Toggle navigation menu">&#9776;</button>

        <!-- Logo -->
        <div id="logo">HAVENLY</div>

        <!-- Navigation Links -->
        <nav>
            <ul>
                <li><a href="#how-it-works">HOW IT WORKS</a></li>
                <li><a href="/products">PRODUCTS</a></li>
                <li><a href="#contact">CONTACT US</a></li>
            </ul>
        </nav>

        <!-- Auth Buttons & Cart -->
        <div class="nav-buttons">
            <a href="#login" class="btn-login">LOGIN</a>
            <a href="#cart" class="btn-cart" title="Shopping Cart">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </a>
        </div>

    </header>

    <!-- ===================== HERO SECTION ===================== -->
    <section id="hero">
        <!-- Dark overlay for text readability -->
        <div id="hero-overlay"></div>
        
        <!-- Centered hero content -->
        <div id="hero-content">
            <h1 id="hero-heading">Design your dream home with us</h1>
        </div>
    </section>

    <!-- ===================== INTRO TEXT SECTION ===================== -->
    <section id="intro-text">
        <p id="intro-paragraph">
            HAVENLY brings comfort, style, and elegance together — creating beautiful spaces with furniture pieces designed to make every home feel warm, modern, and timeless.
        </p>
    </section>

    <!-- ===================== HOW HAVENLY WORKS SECTION ===================== -->
    <section id="how-it-works">

        <!-- Section Title -->
        <p id="section-title">HOW HAVENLY WORKS</p>

        <!-- Informational Text Block -->
        <p id="how-description">
            Explore beautifully curated furniture collections by category and discover pieces that match your style, comfort, and space. Havenly helps you find modern furniture and timeless designs for every room in your home.
        </p>

    </section>

    <!-- ===================== PRICING SECTION ===================== -->
    <!-- ===================== OUR COLLECTIONS SECTION ===================== -->
    <section id="products">

        <!-- Section Heading -->
        <h2 id="products-heading">OUR COLLECTIONS</h2>

        <!-- Collections Grid -->
        <div id="products-grid">

            <!-- Collection 1: Beds -->
            <div class="collection-item">
                <img src="/images/bed.jpg" alt="Bed Collection" class="collection-image">
                <h3 class="collection-caption">BED</h3>
            </div>

            <!-- Collection 2: Sofas -->
            <div class="collection-item">
                <img src="/images/sofa.jpg" alt="Sofas Collection" class="collection-image">
                <h3 class="collection-caption">SOFAS</h3>
            </div>

            <!-- Collection 3: Coffee Tables -->
            <div class="collection-item">
                <img src="/images/coffee-table.jpg" alt="Coffee Tables Collection" class="collection-image">
                <h3 class="collection-caption">COFFEE TABLES</h3>
            </div>

            <!-- Collection 4: Consoles and Sideboards -->
            <div class="collection-item">
                <img src="/images/console.jpg" alt="Consoles and Sideboards Collection" class="collection-image">
                <h3 class="collection-caption">CONSOLES AND SIDEBOARDS</h3>
            </div>

            <!-- Collection 5: Chairs -->
            <div class="collection-item">
                <img src="/images/chair.jpg" alt="Chairs Collection" class="collection-image">
                <h3 class="collection-caption">CHAIRS</h3>
            </div>

        </div>

    </section>

    <!-- WHAT'S NEW CAROUSEL SECTION -->
    <section id="whats-new">

        <h2 id="whats-new-heading">WHAT'S NEW</h2>
        <p id="whats-new-subtitle">Explore our new arrivals</p>

        <!-- Carousel Container -->
        <div id="carousel-wrapper">
            <div id="whats-new-carousel">
                <div id="whats-new-grid">

                    <div class="whats-new-card">
                        <img src="/images/sofa-alfred.jpg" alt="ALFRED SOFA" class="whats-new-image">
                        <h3 class="whats-new-name">ALFRED SOFA</h3>
                        <p class="whats-new-price">Rs.320,000.00</p>
                    </div>

                    <div class="whats-new-card">
                        <img src="/images/sofa-alfresco.jfif" alt="AL FRESCO SOFA" class="whats-new-image">
                        <h3 class="whats-new-name">AL FRESCO SOFA</h3>
                        <p class="whats-new-price">Rs.380,000.00</p>
                    </div>

                    <div class="whats-new-card">
                        <img src="/images/wooden accent chair.jfif" alt="WOODEN ACCENT CHAIR" class="whats-new-image">
                        <h3 class="whats-new-name">WOODEN ACCENT CHAIR</h3>
                        <p class="whats-new-price">Rs.110,000.00</p>
                    </div>

                    <div class="whats-new-card">
                        <img src="/images/industrial accent chair.jfif" alt="INDUSTRIAL ACCENT CHAIR" class="whats-new-image">
                        <h3 class="whats-new-name">INDUSTRIAL ACCENT CHAIR</h3>
                        <p class="whats-new-price">Rs.125,000.00</p>
                    </div>

                    <div class="whats-new-card">
                        <img src="/images/sideboard-hovered.jfif" alt="HOVER SIDEBOARD" class="whats-new-image">
                        <h3 class="whats-new-name">HOVER SIDEBOARD</h3>
                        <p class="whats-new-price">Rs.345,000.00</p>
                    </div>

                    <div class="whats-new-card">
                        <img src="/images/calgary-accent-chair.jfif" alt="CALGARY ACCENT CHAIR" class="whats-new-image">
                        <h3 class="whats-new-name">CALGARY ACCENT CHAIR</h3>
                        <p class="whats-new-price">Rs.145,000.00</p>
                    </div>

                </div>
            </div>
        </div>

        <!-- Carousel Controls -->
        <div id="carousel-controls">
            <button id="carousel-prev" class="carousel-btn carousel-btn-prev">&#10094;</button>
            <span id="carousel-counter" class="carousel-counter">Showing 1 of 6</span>
            <button id="carousel-next" class="carousel-btn carousel-btn-next">&#10095;</button>
        </div>

        <!-- View All Button -->
        <div id="whats-new-button-wrap">
            <button id="whats-new-button" type="button">View All</button>
        </div>

    </section>

    <!-- Partners section removed -->

    <!-- ===================== HAPPINESS GUARANTEE BANNER ===================== -->
    <section id="guarantee">

        <p id="guarantee-label">OUR HAPPINESS GUARANTEE</p>
        <p id="guarantee-text">
            We know designing your home can be an intimidating experience. If you&rsquo;re not happy
            with your design for whatever reason, let us know, and we&rsquo;ll make it right.
        </p>

    </section>

    <!-- VISIT STORE SECTION -->
    <section id="visit-store">

        <div class="visit-store-overlay"></div>

        <div class="visit-store-content">
            <h2 id="visit-store-heading">THE VESSEL</h2>
            <p id="visit-store-subtitle">Visit our studio for a complete experience</p>
        </div>

    </section>

    <!-- ===================== FOOTER ===================== -->
    <footer id="contact">

        <div id="footer-columns">

            <!-- Column 1: Company -->
            <div class="footer-col">
                <h4 class="footer-heading">Company</h4>
                <ul class="footer-links">
                    <li><a href="#">Careers</a></li>
                    <li><a href="#">Design Careers</a></li>
                    <li><a href="#">Reviews</a></li>
                    <li><a href="#">Pricing</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Press Inquiries</a></li>
                </ul>
            </div>

            <!-- Column 2: Explore -->
            <div class="footer-col">
                <h4 class="footer-heading">Explore</h4>
                <ul class="footer-links">
                    <li><a href="#">Style Quiz</a></li>
                    <li><a href="#">Financing</a></li>
                    <li><a href="#">Gift Cards</a></li>
                    <li><a href="#">Refer &amp; Earn</a></li>
                    <li><a href="#">Help Center</a></li>
                    <li><a href="#">Promotions</a></li>
                    <li><a href="#">Havenly AI</a></li>
                </ul>
            </div>

            <!-- Column 3: In-Person Locations (nested two-column list) -->
            <div class="footer-col" id="col-locations">
                <h4 class="footer-heading">In-Person<br>Locations</h4>
                <!-- Nested list: outer = rows, inner = left/right city pairs -->
                <ul class="footer-links locations-grid">
                    <li><a href="#">Austin</a></li>
                    <li><a href="#">Los Angeles</a></li>
                    <li><a href="#">Boston</a></li>
                    <li><a href="#">New York</a></li>
                    <li><a href="#">Chicago</a></li>
                    <li><a href="#">Seattle</a></li>
                    <li><a href="#">Dallas</a></li>
                    <li><a href="#">Washington DC</a></li>
                    <li><a href="#">Denver</a></li>
                    <li><a href="#" class="link-underline">View All Locations</a></li>
                    <li><a href="#">Houston</a></li>
                </ul>
            </div>

            <!-- Column 4: Our Brands + Contact (nested sections) -->
            <div class="footer-col">
                <h4 class="footer-heading">Our Brands</h4>
                <ul class="footer-links">
                    <li><a href="#">Interior Define</a></li>
                    <li><a href="#">The Citizenry</a></li>
                    <li><a href="#">Burrow</a></li>
                    <li><a href="#">The Inside</a></li>
                    <li><a href="#">St. Frank</a></li>
                </ul>

                <!-- Nested sub-section: Contact -->
                <h4 class="footer-heading" style="margin-top: 30px;">Contact</h4>
                <ul class="footer-links">
                    <li>Email</li>
                    <li><a href="mailto:hello@havenly.com">hello@havenly.com</a></li>
                </ul>
            </div>

            <!-- Column 5: Follow Us -->
            <div class="footer-col">
                <h4 class="footer-heading">Follow Us</h4>
                <!-- Social icons as bold text characters -->
                <div id="social-icons">
                    <a href="#" class="social-icon">&#102;</a>
                    <a href="#" class="social-icon">&#116;</a>
                    <a href="#" class="social-icon">&#9679;</a>
                    <a href="#" class="social-icon">&#9689;</a>
                </div>
            </div>

        </div>

        <!-- Bottom copyright bar -->
        <div id="footer-bottom">
            <span>2026 Havenly Inc., All Rights Reserved.</span>
            <div id="footer-bottom-links">
                <a href="#">Find us in the App Store</a>
                <span class="footer-sep">|</span>
                <a href="#">Privacy Policy</a>
                <span class="footer-sep">|</span>
                <a href="#">Terms of Service</a>
                <span class="footer-sep">|</span>
                <a href="#">ADA Accessibility</a>
                <span class="footer-sep">|</span>
                <a href="#">Do Not Sell My Personal Information</a>
                <span class="footer-sep">|</span>
            </div>
        </div>

    </footer>

    <!-- External JavaScript file -->
    <script src="/js/script.js"></script>

</body>

</html>
