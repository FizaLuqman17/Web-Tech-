<!-- ===================================================
     views/products.ejs — Dynamic Product Catalog Page
     =================================================== -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Havenly - All Products">
    <title>Havenly - All Products</title>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body>

    <!-- ===================== NAVBAR (same as homepage) ===================== -->
    <header id="navbar">
        <button id="hamburger-btn" aria-label="Toggle navigation menu">&#9776;</button>

        <div id="logo"><a href="/" style="color:inherit; text-decoration:none;">HAVENLY</a></div>

        <nav>
            <ul>
                <li><a href="/#how-it-works">HOW IT WORKS</a></li>
                <li><a href="/products">PRODUCTS</a></li>
                <li><a href="/#contact">CONTACT US</a></li>
            </ul>
        </nav>

        <div class="nav-buttons">
            <a href="#login" class="btn-login">LOGIN</a>
            <a href="#cart" class="btn-cart" title="Shopping Cart">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </a>
        </div>
    </header>

    <!-- ===================== PRODUCTS PAGE ===================== -->
    <main id="products-page">

        <h1 id="products-page-heading">All Products</h1>
        <p id="products-page-subtitle">Browse our complete furniture collection</p>

        <!-- ===================== FILTER / SEARCH FORM ===================== -->
        <form id="filter-form" method="GET" action="/products" autocomplete="off">

            <div class="filter-row">

                <input type="text" name="search" placeholder="Search by product name..." value="<%= search || '' %>" class="filter-input">

                <select name="category" class="filter-select">
                    <option value="">All Categories</option>
                    <option value="Sofas" <%= category === 'Sofas' ? 'selected' : '' %>>Sofas</option>
                    <option value="Chairs" <%= category === 'Chairs' ? 'selected' : '' %>>Chairs</option>
                    <option value="Tables" <%= category === 'Tables' ? 'selected' : '' %>>Tables</option>
                    <option value="Beds" <%= category === 'Beds' ? 'selected' : '' %>>Beds</option>
                    <option value="Consoles" <%= category === 'Consoles' ? 'selected' : '' %>>Consoles</option>
                    <option value="Storage" <%= category === 'Storage' ? 'selected' : '' %>>Storage</option>
                </select>

                <input type="number" name="minPrice" placeholder="Min Price" value="<%= minPrice || '' %>" class="filter-input filter-price" min="0">

                <input type="number" name="maxPrice" placeholder="Max Price" value="<%= maxPrice || '' %>" class="filter-input filter-price" min="0">

                <select name="sort" class="filter-select">
                    <option value="" <%= sort === '' ? 'selected' : '' %>>Default</option>
                    <option value="priceAsc" <%= sort === 'priceAsc' ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="priceDesc" <%= sort === 'priceDesc' ? 'selected' : '' %>>Price: High to Low</option>
                    <option value="ratingDesc" <%= sort === 'ratingDesc' ? 'selected' : '' %>>Rating: High to Low</option>
                </select>

                <button type="submit" class="filter-btn">Apply</button>
                <a href="/products" class="filter-clear">Clear</a>

            </div>

        </form>

        <!-- ===================== RESULT SUMMARY ===================== -->
        <p class="results-info">
            <% if (totalProducts === 0) { %>
                No products match your filters.
            <% } else { %>
                Showing <%= products.length %> of <%= totalProducts %> products
                (Page <%= currentPage %> of <%= totalPages %>)
            <% } %>
        </p>

        <!-- ===================== PRODUCT GRID ===================== -->
        <div id="product-grid">
            <% products.forEach(function(product) { %>
                <div class="product-card">
                    <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
                    <div class="product-info">
                        <h3 class="product-name"><%= product.name %></h3>
                        <p class="product-category"><%= product.category %></p>
                        <p class="product-price">Rs.<%= product.price.toLocaleString() %></p>
                        <div class="product-meta">
                            <span class="product-rating">&#9733; <%= product.rating %></span>
                            <span class="product-stock">
                                <% if (product.stock > 0) { %>
                                    In Stock: <%= product.stock %>
                                <% } else { %>
                                    Out of Stock
                                <% } %>
                            </span>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

        <!-- ===================== PAGINATION ===================== -->
        <%
            // Build a base query string that preserves all filters except `page`
            function buildPageLink(pageNum) {
                const params = [];
                if (search)   params.push("search="   + encodeURIComponent(search));
                if (category) params.push("category=" + encodeURIComponent(category));
                if (minPrice) params.push("minPrice=" + encodeURIComponent(minPrice));
                if (maxPrice) params.push("maxPrice=" + encodeURIComponent(maxPrice));
                if (sort)     params.push("sort="     + encodeURIComponent(sort));
                params.push("page=" + pageNum);
                return "/products?" + params.join("&");
            }
        %>

        <% if (totalPages > 1) { %>
            <div id="pagination">

                <% if (currentPage > 1) { %>
                    <a href="<%= buildPageLink(currentPage - 1) %>" class="page-btn">&laquo; Prev</a>
                <% } else { %>
                    <span class="page-btn disabled">&laquo; Prev</span>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="page-btn active"><%= i %></span>
                    <% } else { %>
                        <a href="<%= buildPageLink(i) %>" class="page-btn"><%= i %></a>
                    <% } %>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="<%= buildPageLink(currentPage + 1) %>" class="page-btn">Next &raquo;</a>
                <% } else { %>
                    <span class="page-btn disabled">Next &raquo;</span>
                <% } %>

            </div>
        <% } %>

    </main>

    <!-- ===================== FOOTER (simplified) ===================== -->
    <footer id="contact">
        <div id="footer-bottom">
            <span>2026 Havenly Inc., All Rights Reserved.</span>
        </div>
    </footer>

    <script src="/js/script.js"></script>

</body>

</html>
