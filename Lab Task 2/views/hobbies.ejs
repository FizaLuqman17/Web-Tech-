<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hobbies - Havenly</title>
  <link rel="stylesheet" href="/css/site.css" />
  <style>
    body { background: #edebe6; color: #1a1a1a; }
    .simple-wrap { max-width: 760px; margin: 80px auto; padding: 32px; background: #fff; border-radius: 12px; }
    .simple-wrap h1 { margin-top: 0; font-family: Georgia, serif; }
    .simple-wrap ul { padding-left: 20px; line-height: 1.9; }
    .simple-wrap a { color: #8b0020; font-weight: bold; }
  </style>
</head>
<body>
  <div class="simple-wrap">
    <h1>Hobbies</h1>
    <ul>
      <% hobbies.forEach((hobby) => { %>
        <li><%= hobby %></li>
      <% }) %>
    </ul>
    <p><a href="/">Back to homepage</a></p>
  </div>
</body>
</html>
